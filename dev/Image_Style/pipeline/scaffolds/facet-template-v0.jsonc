  "인물": { // 정물 보드가 나르지 못하는 부분. 캐릭터 프롬프트에 텍스트로 주입하는 '방언 절'의 재료이며, 실측 결과 인물 스타일 전이의 결정 변수였다(refer1: 방언 절 유무로 58→79점).
    "표본 수": "ex. 0", // 원작에 보이는 인물 수(정수). 0이면 아래 값은 전부 [외삽]이고 방언 절 첫 토큰을 [EXTRAPOLATED]로 표기한다. 2인 이상이면 공유 특징만 채택한다(refer3: 2인이 공유한 코·점눈·비율만).
    "등신": "ex. [외삽] 3~4등신", // 머리 대비 신장 비율(refer1 초장신 다리 60%+ / refer3 3.5등신 / refer2 7.5등신).
    "두상·얼굴형": "ex. [외삽] 둥근 직사각 두상", // 두상과 얼굴형.
    "눈": {
      "크기": "ex. [외삽] 아주 작음", // 얼굴 대비 눈 크기.
      "처리": "ex. [외삽] 점", // [4개 중 1개 선택: 점 / 실선 / 큰 애니 눈(글린트) / 무얼굴 — 분석 근거: refer3 점, refer1 미니멀 점·실선, refer2 큰 애니 눈+글린트, refer6 무얼굴 실측]. 후보 밖(사실적 눈 등)이면 자유 서술 후 갱신 제안.
      "디테일": "ex. [외삽] 최소" // 눈 내부 디테일 수준(홍채·글린트·속눈썹).
    },
    "코": "ex. [외삽] 생략", // 코 처리(생략 / 점 / 선 / 거대 둥근 코 — refer3은 얼굴을 지배하는 거대 둥근 코).
    "입": "ex. [외삽] 짧은 실선", // 입 처리.
    "무얼굴 여부": "ex. [외삽] 아니오", // [2개 중 1개 선택: 예 / 아니오 — 분석 근거: refer6 무얼굴 실루엣이 방언으로 실측(표정 지시를 포즈로 흡수)]. 예면 눈·코·입 값은 [해당 없음].
    "헤어 구축": "ex. [외삽] 캡 모양 단일 덩어리", // 헤어 조형 방식. '재질.헤어.구축'과 같은 값.
    "손": "ex. [외삽] 미튼형 또는 짧은 선 훅", // 손 처리(미튼 / 분리 손가락 / 몰드 / 생략).
    "의상": {
      "재질": "ex. [외삽] 플랫 패널", // 의상 재질 표현. 스타일의 재질 사전이 콘텐츠 재질 지시를 덮어쓸 수 있다(refer3: 레인코트 → 니트 코트).
      "주름": "ex. [외삽] 최소 봉제선", // 주름·봉제선 표현.
      "실루엣": "ex. [외삽] 블록형" // 의상 실루엣(블록 / 사다리꼴 / 흐르는).
    },
    "포즈 문법": "ex. [외삽] 정면·3/4 실루엣 중심, 경직된 미니어처 포즈" // 포즈의 문법(경직 / 다이내믹 / 3중 기울기 등).
  },

  "장식": { // 화면에 흩뿌려지는 반복 부호. 콘텐츠 복제가 아니라 '다른 팔레트·다른 대상에서도 반복 가능한 문법'인 것만 스타일로 인정한다(refer1 ABCD 모작 폐기 → ABCDE 일반화 복권 사례).
    "어휘": "ex. 작은 윤곽 방울, 짧은 물결선, 점열", // 반복 부호의 종류(refer1 4각 스파클 / refer6 점선 궤적 / refer2 골드 보케).
    "크기 편차": "ex. 작음~중간", // 부호 크기의 편차.
    "점유율": "ex. 낮음 (화면의 2~3%)", // 부호가 차지하는 화면 면적.
    "산포 리듬": "ex. 불균일 [실측]", // [3개 중 1개 선택: 등간격 / 불균일 / 판정 불가 — 분석 근거: refer1 E′ A/B에서 불균일 절의 효과 실측, 모델은 지시가 없으면 등간격으로 회귀]. 불균일이 시그니처면 프롬프트에 명시한다.
    "전경 통과": "ex. 없음", // 부호가 전경 사물 앞을 지나는지(refer1은 일부 스파클이 전경 통과).
    "Content-bound 후보": "ex. 하트형 표식, 돛 모양 — 장면 종속" // 원작 고유라 제거할 것. 실제 금지문은 '생성 규칙.부정 절'에서 한 번만 쓴다.
  },

  "디테일": {
    "분포": { // 스케일과 무관한 화면 내 밀도.
      "초점:주변": "ex. 주체 내부 중간 밀도, 여백은 부호만", // 초점부와 주변부의 밀도 차.
      "실루엣:내부선": "ex. 실루엣 명확, 내부는 창·패널 반복선", // 실루엣 정보와 내부 정보의 비중.
      "장식:재질": "ex. 장식 반복이 디테일 역할, 재질 묘사 없음", // 디테일이 장식 반복에서 오는지 재질 묘사에서 오는지.
      "반복 장식 격자 여부": "ex. 구조 반복선은 격자 허용, 장식은 느슨" // 반복 요소가 격자 정렬인지 느슨한 리듬인지.
    },
    "스케일 LOD": { // 크기에 따라 무엇을 생략하는가. 관찰된 스케일만 [실측], 나머지는 '관찰된 문법을 넘지 않음'으로 외삽.
      "원경 인물": "ex. [외삽] 점·생략", // 원경 인물의 디테일 수준.
      "중경 소품": "ex. [실측] 외곽 + 반복 내부선만", // 중경 소품의 디테일 수준.
      "클로즈업": "ex. [외삽] 관찰된 선/면 문법을 넘지 않음" // 클로즈업에서 허용되는 최대 디테일.
    }
  },

  "분위기": { // 기록만 한다. 앵커 프롬프트에 굽지 않고 나중에 modifier로 후행 주입한다(v2 원칙 '톤은 modifier').
    "인상": "ex. 가볍고 정돈된 테크 다이어그램", // 한두 단어의 인상.
    "시각적 원인": "ex. 넓은 순백 여백 + 낮은 채도 + 단순 기하 + 선명한 단일 액센트" // 인상을 만드는 시각적 원인. 원인 없는 형용사(예쁜, 강렬한)는 생성 변수로 접지되지 않는다.
  },

  "분류": { // 위 속성들을 등급으로 묶은 요약. Core = 없으면 그 그림체로 안 보임, Supporting = 강화하지만 장면 따라 소실, Content-bound = 작품엔 자주 나오지만 스타일 아님.
    "Core": "ex. 순백 바탕, 아이소 평행 투영, 청회색 폐곡선 선화, 선택적 진청 스폿 채움, 플랫 오프셋 그림자, 매끈한 정연함", // 캡슐에서 가장 강하게 실을 것.
    "Supporting": "ex. 소산포 장식 부호, 중간 밀도 내부 반복선", // 있으면 좋지만 장면 따라 빠질 수 있는 것.
    "Content-bound": {
      "Scene-specific": "ex. 큰 운송수단, 해안 구조물, 돛·탑 모양, 하트형 표식", // 장면 종속 콘텐츠. 부정 절 (c)의 재료.
      "Artifacts": "ex. 회색 캐스트, 노이즈, 흐림, 모아레" // 입력 아티팩트. 부정 절 (a)의 재료. '입력.아티팩트'와 같은 목록.
    }
  },

  "생성 규칙": { // 그림의 속성이 아니라, 분석에서 유도한 '생성 시 적용할 제어'. 실측으로 이것들이 선언 → 생성까지 전달됨을 확인했다(refer6 야간 외삽 규칙, refer5 액센트 위치 규칙).
    "오버라이드": { // 스타일 문법이 콘텐츠 지시를 덮어쓰는 층. 실측 기본값: 색은 콘텐츠가 이기고(refer5 teal·mustard가 모노크롬을 깸), 재질(refer3)·조형/얼굴(refer6)·투영(refer5)은 스타일이 이긴다.
      "색": "ex. 스타일 strict near-monochrome, 유저 색 지시는 순도 토글 ON일 때만 제한", // 색 축에서 누가 이기는가와 조건.
      "재질": "ex. 스타일 재질 사전 우선 — 콘텐츠 재질은 공통 문법 안에서만 변환", // 재질 축.
      "조형·얼굴": "ex. 스타일 우선 — 인물 요청 시 외삽 방언 적용", // 조형·얼굴 축.
      "투영": "ex. 스타일 우선 — 정면·렌즈 원근 명시 시에만 교체", // 투영 축.
      "배경": "ex. 순백 우선 — 닫힌 색면 배경 명시 시에만 오프화이트/틴트" // 배경 축.
    },
    "외삽": { // '입력.표본.부재 영역'의 각 항목을 스타일의 생성 규칙으로 메우는 법. 관찰된 선·채움·팔레트·정밀도 문법보다 강하게 쓰지 않는다.
      "인물": "ex. 관찰된 선 문법으로 외삽 (점눈·실선입·미튼 손)", // 인물 부재 시 규칙.
      "곡면": "ex. 폐곡선 + 플랫 채움 유지", // 곡면 부재 시 규칙(refer6은 면별 명도를 유지한 로우폴리).
      "야간": "ex. 바탕 명도 소폭 하강 + 청회색 그림자 면 확대 + 발광체 플랫 웨지", // 야간 부재 시 규칙(refer6 실측: 명도 시프트 + 광원 웨지).
      "실내": "ex. 같은 투영·선·채움 문법으로 방코너 구성" // 실내 부재 시 규칙.
    },
    "부정 절": { // 이 스타일이 아닌 것. 영문 한 문장('Avoid …', 35단어 이내)으로 프롬프트 말미에 붙는다. 외삽에서 유래한 금지(표본 없는 인물의 얼굴 디테일 등)는 넣지 않는다.
      "아티팩트": "ex. gray photographic cast, moiré, sensor noise, blur", // (a) 입력 아티팩트.
      "충돌 기본값": "ex. generic gradients, realistic texture, black outlines, drop shadows, evenly spaced decorations", // (b) 스타일과 충돌하는 생성기 기본값.
      "장면 종속": "ex. copied vehicles, shoreline structures, tiny hearts, sails, tower", // (c) 장면 종속 모티프·의상·소품.
      "텍스트·로고": "ex. readable text, logos" // (d) 텍스트·로고.
    },
    "게이트 판정": { // 조건부로 넣는 절의 통과/불통과 기록. 조건은 위 값들(위계비, 변화량, 시그니처, 산포 리듬, 색상 다양성, 캡처 계층, 복원 목표, 인물 표본 수)만 참조한다.
      "삽입": "ex. line_hierarchy, decor_uneven, strict_monochrome_board, white_ground_restore, scene_ref_replacement", // [9개 중 n개 선택: asymmetric_structure / line_hierarchy / decor_uneven / strict_monochrome_board / strict_monochrome_transfer / white_ground_restore / physical_photo_texture / figure_rules / scene_ref_replacement — 분석 근거: v4 게이트 표(조건식은 scaffolds/v4.md)]. 통과한 게이트 이름을 전부 나열.
      "생략": "ex. asymmetric_structure, physical_photo_texture, figure_rules" // [9개 중 n개 선택: '삽입'과 같은 후보 9개 — 분석 근거: '삽입'과 같음]. 불통과한 게이트 이름. '삽입'과 합쳐 9개가 되어야 한다.
    },
    "파라미터 후보": "ex. 팔레트 오버라이드 허용, 방언 강도 medium, 룩 옵션(표준/각진 보드), strict monochrome 토글" // 유저에게 노출할 수 있는 변수. 기록만 하고 프롬프트에는 넣지 않는다.
  }
}
