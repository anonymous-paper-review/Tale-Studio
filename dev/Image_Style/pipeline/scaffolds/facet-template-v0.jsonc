      "표시 방식": "ex. 이중 윤곽 + 사선 광선 2개", // 유리를 무엇으로 표시하는가(윤곽만 / 사선 광선 / 화이트 스트립 / 채움색).
      "뒤쪽 왜곡": "ex. 없음" // 유리 뒤 사물의 굴절 왜곡 유무.
    },
    "천": {
      "주름 크기": "ex. 큰 덩어리 1~3개", // 주름이 큰 덩어리인지 작은 주름 다발인지.
      "섬유": "ex. 보이지 않음", // 섬유·직조가 보이는지(refer3은 니트 스티치 열이 보임).
      "무게감": "ex. 둥근 처짐 실루엣으로만", // 천의 무게를 무엇으로 표현하는가.
      "그림자 경계": "ex. hard" // 천 주름 그림자의 경계 경도.
    },
    "유기물": { // 과일·피부처럼 광택·반투명이 있을 수 있는 것.
