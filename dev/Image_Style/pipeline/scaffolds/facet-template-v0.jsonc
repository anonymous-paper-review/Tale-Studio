{
  // ===== facet 템플릿 v0.2 — 조립도 본문 (2026-09-04) =====
  // 그림 한 장의 시각 속성을 거의 1:1로 대응시키는 "조립도". key = 속성을 대표하는 단어, value = 그 속성의 값(초안이므로 "ex."로 시작하는 예시값), 주석 = 그 key가 가리키는 것 · 관찰/측정 방법 · 실험에서 배운 함정.
  // 목적·작성 규칙·값 규칙은 facet-template-v0.guide.md, 입력(파일의 성격) 서식은 facet-input-v0.jsonc에 있다. 주석의 '입력.…'은 그 파일의 키를 가리키며, 채우는 순서는 입력 → 본문이다.
  // 출처: 스캐폴드 v4의 24축 + 재질 사전 11종 + refer1~6 실측(dev/Image_Style). 초안이라 우리가 실제로 만난 속성만 담았고, 분기(사진성·인물 등)는 표본이 생기는 대로 깊어진다.

  "그림체": { // 사진이 아닌 '그려진 이미지'가 갖는 특징. 입력.캡처 계층이 b·c여도 그림 내부의 의도된 렌더링만 여기에 적는다.
    "매체": {
      "엔진": "ex. 디지털 잉크 선화 + 플랫 셀 채움", // 무엇으로 만든 것처럼 보이는가. 참고 후보: 디지털 페인팅 / 셀 / 수채 / 과슈 / 유화 / 잉크 / 벡터 / 3D / 실사 / 스톱모션·공예 / 콜라주 — 혼합이 흔해 자유 서술. 이름으로 끝내지 말고 '재료 외관'에서 외관을 적는다.
      "재료 외관": "ex. 매끈한 벡터 면, 종이결 없음, 안료 번짐 없음" // 재료가 실제로 어떻게 보이는지(예: 투명한 워시, 콜드프레스 종이결, 안료 고임). 캡슐 첫 문장의 재료가 된다.
    },
    "선": { // 경계를 선이 만드는 스타일에서 채운다. 무선 면분할(refer6)이면 '외곽선.유무'가 없음이고 나머지는 [해당 없음].
      "외곽선": { // 인물·주요 사물과 배경, 또는 인물·주요 사물 사이의 경계선.
        "유무": "ex. 있음", // [2개 중 1개 선택: 있음 / 없음 — 분석 근거: refer6 무선 면분할이 '없음'의 실측 표본]. 없음이면 경계는 면의 명도차가 만든다 → '채움.토폴로지' b.
        "굵기": "ex. 2~3px (2048px 기준)", // 화면 기준 절대 굵기. 기준 해상도를 함께 적는다. 같은 이미지 안의 내부선과 비교하는 값은 '위계비'.
        "변화량": "ex. 하나의 선에서 굵기 변화 없음(일정 스트로크), 0.5/5", // 테이퍼·필압. 0~5 척도를 함께 적는다(Style Vector '선 변화'). 2.0 이하면 균일선으로 보고 프롬프트에 'uniform line weight everywhere'를 넣는다.
        "색": "ex. #4e547f 청회색 (실측 #585d88, 캐스트 보정)", // 검정처럼 보여도 남색·갈색인 경우가 많다. 촬영본은 실측 선색과 보정 선색을 분리하고 프롬프트에는 보정값만 쓴다.
        "연속성": "ex. 끊김 없는 폐곡선", // 참고 후보: 연속 폐곡선 / 끊김 / 스케치풍 겹침 — 자유 서술. 폐곡선 여부는 채움 토폴로지 a의 전제.
        "코너": "ex. 라운드 처리, 반경 작음", // 코너가 둥근가 각진가와 반경. '형태.코너 반경'과 같은 값이어야 한다.
        "위계비": "ex. 1.6 [실측]" // 외곽선 굵기 / 내부선 굵기 (숫자). 1.5 이상이고 [실측]이며 변화량 2.5 이상일 때만 '선 3단계 위계' 절을 넣는다. refer5 v3 카드가 [보정] 주장만으로 위계 절을 넣은 것이 이 수치 규칙을 만든 계기.
      },
      "내부선": { // 사물 내부의 구조선·묘사선(창, 패널, 주름).
        "양": "ex. 적음 — 창·패널 반복선 정도", // [4개 중 1개 선택: 없음 / 적음 / 중간 / 많음 — 분석 근거: refer1(적음, 디테일은 색 도형으로)·refer2(많음)·refer5(적음)·refer6(없음) 실측]. 선택 뒤 무엇이 있는지 덧붙인다.
        "굵기": "ex. 1~2px", // 절대 굵기. 외곽선 굵기와의 비가 '위계비'.
        "역할": "ex. 구조 분할 위주, 해칭 없음" // 참고 후보: 구조선 / 장식선 / 해칭·음영선 — 자유 서술. 해칭이 있으면 '명암.폼 섀도'와 겹치므로 대조한다.
      },
      "배경선": {
        "굵기": "ex. 1~2px, 가장 얇음" // 배경 내부선의 절대 굵기. 3단계 위계의 마지막 단계인지 확인한다.
      },
      "그림자 경계선": "ex. 닫지 않음", // [2개 중 1개 선택: 선으로 닫음 / 닫지 않음 — 분석 근거: refer1(닫지 않음, 면으로만)·refer2(셀 그림자 경계 선 없음) 실측]. 그림자 덩어리의 가장자리를 선으로 두르는가.
      "가장자리": { // 선의 유무와 별개로, 면과 면이 만나는 곳의 선명도.
        "선명도": "ex. hard", // [3개 중 1개 선택(주된 것): hard / soft / lost — 분석 근거: refer1·5·6 hard, refer2 그라디언트 경계 soft, refer3 사진 soft 실측]. 중심 hard·주변 soft 같은 분포는 '재질별 차이'에 덧붙인다.
        "재질별 차이": "ex. 없음" // 유리만 soft, 천만 lost 같은 예외를 자유 서술.
      }
    },
    "채움": { // 경계 안쪽을 무엇으로 채우는가. 같은 아이소메트릭 계열이 refer5(선+선택 채움)와 refer6(무선 면분할)로 갈린 결정 축.
      "토폴로지": "ex. a", // [4개 중 1개 선택: a 폐곡선 선화+선택적 스폿 채움 / b 무선 면 명도차 / c 플랫 셀 채움 / d 페인터리·그라디언트 혼합 — 분석 근거: refer5(a)·refer6(b)·refer1(c)·refer2(d) 네 유형 전부 실측].
      "선택 채움 논리": "ex. 물·창·패널·하부면에만 솔리드 블루, 나머지는 흰 면", // 토폴로지 a일 때 '어떤 면에만 색이 오는가'. 액센트 규칙의 위치 조건이 된다. a가 아니면 [해당 없음].
      "채움색 수": "ex. 3 (흰색, 옅은 회색, 진청)", // 채움에 쓰인 색 수(정수)와 내역.
      "그라디언트": "ex. 허용 안 함", // [2개 중 1개 선택: 허용 / 불허 — 분석 근거: refer1 불허(머리카락만 2-stop 예외)·refer2 허용 실측]. 허용이면 형태(선형 2단 등)를 덧붙인다.
      "면별 명도 단계": "ex. 해당 없음" // 토폴로지 b의 핵심: 윗면 최명 / 측면 중간 / 반대 측면 암부 같은 단계 수와 광방향이 전 오브젝트에서 일관되는지(refer6 3단). b가 아니면 [해당 없음].
    },
    "명암": { // 색을 빼고 흑백으로 봤을 때의 규칙. 색을 아무리 맞춰도 명암 구조가 다르면 다른 스타일로 보인다.
      "키": "ex. 하이키", // [3개 중 1개 선택: 하이키 / 미드 / 로우키 — 분석 근거: refer1·3·5·6 하이키, refer2 미드(연극 조명) 실측]. 명도 평균 수치(style_stats)를 근거로 함께 적는다.
      "단계 수": "ex. 3~4단 (흰 면, 옅은 회색 면, 청회색 그림자, 진청 액센트)", // 명암 단계 수와 각 단계의 내역.
      "순검정": "ex. 없음", // 순검정(#000 근방) 존재 여부와 위치. 검정처럼 보이는 선이 실제 남색인지도 여기서 확인.
      "배경 대비 주체": "ex. 밝기 차 작음 — 선과 액센트로 분리", // 배경과 주체의 밝기 차, 분리를 무엇이 담당하는지.
      "폼 섀도": { // 물체 자체의 명암(둥근 면의 어두운 쪽).
        "유무": "ex. 거의 없음", // 있음/없음/거의 없음과 어디에 있는지. 플랫 스타일은 없음이 시그니처.
        "경도": "ex. 해당 없음" // 폼 섀도 경계가 hard(셀 1단)인지 soft(그라디언트)인지. 없으면 [해당 없음].
      },
      "캐스트 섀도": { // 물체가 바닥에 떨어뜨리는 그림자. 같은 물체도 이것 하나로 룩이 갈린다.
        "유형": "ex. flat_offset", // [4개 중 1개 선택: none / soft_contact / flat_offset / planar — 분석 근거: refer1 none, refer3 soft_contact, refer5 flat_offset(청회색 타원), refer6 planar(면 그림자) 네 유형 전부 실측].
        "색": "ex. #b7c0df 청회색", // 그림자 색 hex. 명도만 내린 것인지 색상 시프트가 있는지.
        "방향": "ex. 좌하향, 전 오브젝트 일관", // 방향과 전 오브젝트 일관성 여부.
        "블러": "ex. 없음 (hard edge)" // 그림자 가장자리 블러 반경. 없으면 hard edge.
      }
    },
    "색": {
      "팔레트": { // 역할별 hex와 면적 비율. 촬영본은 실측치와 보정치를 함께 적는다(refer5 실측 #585d88 → 보정 #254bd6).
        "Primary": "ex. #ffffff 55%", // 가장 넓은 면의 색과 면적 %.
        "Secondary": "ex. #e8e9ea 25%", // 두 번째 면의 색과 면적 %.
        "Accent": "ex. #254bd6 ≤ 8%", // 포인트 색 hex와 면적 상한. 액센트 hex는 프롬프트에 반드시 함께 명시한다 — v4 런에서 hex가 빠지자 생성기가 옅은 #9ca5d5를 액센트로 써 채도가 회귀했다.
        "Shadow": "ex. #b7c0df 7%", // 그림자에 쓰인 색과 면적 %.
        "Highlight": "ex. #ffffff (별도 없음)", // 하이라이트 색. 흰 면이 곧 하이라이트면 '별도 없음'.
        "선색": "ex. #4e547f 12%" // 선의 색과 면적 %. '선.외곽선.색'과 같은 값이어야 한다.
      },
      "액센트 규칙": { // hex 목록과 별개인 '배분 문법'. refer6의 앰버는 화물·포인트에만 오고, refer5의 블루는 물·창·패널에만 온다.
        "허용 위치": "ex. 물, 창, 선택된 패널, 하부면", // 액센트가 올 수 있는 면의 종류. '채움.선택 채움 논리'와 정합해야 한다.
        "상한": "ex. 8%", // 화면 면적 대비 상한(%). 캡슐에 'accent ≤ N% of the image'로 그대로 실린다. v3 런에서 상한이 캡슐에 없어 창·머그 액체·화분 밴드로 초과했다.
        "개수": "ex. 1색" // 액센트 색의 수.
      },
      "모노크롬 엄격도": "ex. strict near-monochrome (색상 다양성 1.2/5)", // 색상 다양성 0~5와 함께. 1.5 이하이고 액센트 위치가 제한되면 보드 프롬프트에 strict near-monochrome 절을 넣는다. 단 콘텐츠 전이(캐릭터 프로브)는 유저 토글이 없으면 콘텐츠 색 지시를 유지한다 — refer5 실측: 색은 콘텐츠 지시가 이긴다.
      "온도": "ex. 쿨톤", // 전체 색 온도 경향. 참고 후보: 웜 / 쿨 / 중립 / 혼합광 — 자유 서술.
      "조화 유형": "ex. 단색 계열, 보색 없음", // 색 관계(단색 / 유사 / 보색 / 삼색 등)를 자유 서술. 실측 근거가 쌓이기 전이라 선택형 아님.
      "재질 고정색": "ex. 해당 없음 (표본 없음)", // 피부 톤처럼 재질에 묶인 색. 이미지에 실제 표본이 있을 때만 적는다(refer3 비닐 스킨 웜탄 #d5aa60). 없으면 [해당 없음].
      "그림자색": "ex. #b7c0df (색상 시프트 없음, 명도만)", // 그림자가 명도만 내린 것인지 색상이 바뀌는지(refer2는 셀 그림자에 색상 시프트).
      "하이라이트색": "ex. 흰 면 그대로" // 하이라이트 색과 위치.
    },
    "형태": { // 사물과 인물을 어떤 형태로 단순화하는가. 인물뿐 아니라 잎·옷·건물·구름에도 같은 언어가 반복되어야 스타일이다.
      "둥근:각진": "ex. 직선 구조 우세, 끝단은 둥글게 완화", // 둥근 형태와 각진 형태의 비중.
      "코너 반경": "ex. 작음 (라운드 코너)", // 코너의 둥근 정도. '선.외곽선.코너'와 같은 값.
      "실루엣 단순도": "ex. 높음 — 큰 덩어리 우선, 돌기 최소", // 실루엣이 얼마나 단순화됐는지. Style Vector '형태 단순화' 0~5를 함께 적을 수 있다.
      "덩어리 우선": "ex. 예", // 큰 덩어리를 먼저 잡고 세부를 붙이는 방식인지.
      "돌기량": "ex. 적음", // 작은 돌기·세부 형태의 양.
      "곡선:직선": "ex. 35:65", // 곡선과 직선의 비.
      "공통 적용 범위": "ex. 건물·배·식물·소품 전부 동일 단순화" // 같은 형태 언어가 어디까지 적용되는지. 인물만 다르면 '인물' 가지에 기록.
    },
    "정밀도": { // 손맛 vs 기하 정연함. 촬영·압축 흔적(흐림·노이즈)은 불완전성이 아니다 — 원문 스캐폴드가 이걸 손그림 떨림으로 오독해 해칭·워시 룩으로 표류했다.
      "시그니처": "ex. geometric", // [3개 중 1개 선택: geometric / hand_drawn / mixed — 분석 근거: refer1 E′ A/B(비대칭 절 효과)와 refer5·6(정연함 시그니처) 실측]. geometric이면 프롬프트에 'clean geometric regularity', hand_drawn이면 'hand-drawn wobble'.
      "선 떨림": "ex. 없음", // 선의 미세한 흔들림 유무와 정도. 촬영 블러와 구분한다.
      "간격 규칙성": "ex. 창·점열 규칙적, 장식만 불균일", // 반복 요소의 간격이 규칙적인지.
      "축 정렬": "ex. 정확 (평행 투영 축 준수)", // 구조물이 투영 축에 정확히 맞는지, 눈대중인지.
      "색 삐침": "ex. 없음", // 채움이 선 밖으로 벗어나는지(misregistration).
      "구성 비대칭": "ex. 큰 덩어리 2~3개의 비대칭 균형" // 정연함과 별개로 구도가 비대칭인지. 이것 때문에 비대칭 절을 넣어서는 안 된다 — 비대칭 절은 구조물·소품·의상의 좌우 비대칭(refer1)에만 해당.
    },
    "질감·마감": { // 화면 전체에 반복되는 '의도된' 마감. 재질별 세부는 '재질' 가지에.
      "의도 마감": "ex. none (매끈한 디지털 플랫)", // 참고 후보: none / paper_grain / brush / fiber / noise / polish — 아직 자유 서술(brush·paper_grain의 실측 표본이 없어 후보 미확정). 캡처 아티팩트는 여기 넣지 않는다.
      "위치": "ex. 해당 없음", // 마감이 나타나는 위치(배경만 / 전면 / 사물만).
      "역할": "ex. 해당 없음", // 마감의 역할. 'textured' 한 단어로 끝내면 생성기가 전면에 노이즈를 덮는다 — 위치와 역할을 반드시 적는다.
      "인물/배경 차이": "ex. 없음" // 인물과 배경의 마감이 다른지.
    },
    "조명": { // 그림 안의 빛. 그림자는 '명암'에서 다룬다.
      "광원": "ex. 확산", // [4개 중 1개 선택: 자연 / 인공 / 확산 / 무광원 플랫 — 분석 근거: refer3 인공 스튜디오, refer2 연극 인공광, refer1 무광원 플랫, refer5·6 확산 실측]. 혼합광이면 주된 것을 고르고 덧붙인다.
      "방향": "ex. 좌상 (그림자로만 암시)", // 광원 방향과 그것이 무엇으로 드러나는지.
      "크기": "ex. 큼 (부드러운 확산)", // 광원 크기(그림자 경계의 부드러움으로 추정).
      "키:필": "ex. 해당 없음 (플랫)", // 키라이트와 필라이트의 비. 플랫이면 [해당 없음].
      "림라이트": "ex. 없음", // 윤곽광 유무와 색(refer2는 림라이트가 Core).
      "블룸·할레이션": "ex. 없음", // 발광 번짐 유무.
      "발광체": { // 램프·창·화면 같은 빛나는 물체의 표현.
        "표현": "ex. 플랫 채움, 글로우 없음", // 발광체를 플랫 채움으로 그리는지 글로우를 입히는지.
        "라이트 콘·풀": "ex. 없음 (야간 프로브에서는 플랫 웨지로 외삽됨)" // 빛이 만드는 원뿔·웅덩이의 표현. 야간 표본이 없으면 [외삽].
      }
    }
  },

  "사진성": { // 입력.캡처 계층이 d(물리 오브젝트 사진)일 때만 채운다. refer3(스톱모션 퍼펫)에서는 촬영 조건 자체가 스타일의 일부였다. d가 아니면 가지 전체가 [해당 없음].
    "실물 재료 Core": "ex. 예", // [2개 중 1개 선택: 예 / 아니오 — 분석 근거: refer3에서 몰드 비닐·니트·데님·펠트가 스타일 핵심으로 실측]. 예일 때만 촬영 조명·DOF·접지가 스타일로 유지된다.
    "스튜디오광": "ex. 소프트 이븐 하이키, 접지 그림자 옅음", // 촬영 조명의 성격.
    "피사계 심도": "ex. 얕은 미니어처 DOF", // 초점 깊이. 미니어처 사진 특유의 얕은 심도인지.
    "접지 그림자": "ex. 소프트 접지", // 물체와 바닥이 닿는 곳의 그림자.
    "카메라 질감": "ex. 실사 노이즈 없음, 매끈" // 이 분기에서만 촬영 질감이 스타일로 유지된다. b·c에서는 전부 아티팩트.
  },

  "공간": {
    "투영": { // 투영 방식은 스타일 층으로 전이된다 — refer5는 액션 컷까지 아이소메트릭으로 그렸다.
      "방식": "ex. 아이소메트릭·평행 투영", // [5개 중 1개 선택: 선원근 / 아이소메트릭·평행 투영 / 정면 평면 스테이징 / 사진 렌즈 원근 / 디오라마 부감 — 분석 근거: refer1 정면 평면, refer2 선원근, refer3 사진 렌즈, refer5·6 아이소메트릭 실측]. 캡슐 영문 토큰과 1:1 대응.
      "시점 높이": "ex. 높은 3/4 부감", // 카메라 높이.
      "왜곡": "ex. 없음", // 렌즈 왜곡·원근 수렴 정도.
      "깊이": "ex. 얕음", // 공간 깊이감.
      "심도": "ex. 없음 (전면 초점)" // 피사계 심도(초점 흐림) 유무.
    },
    "구도": { // 원작의 배치를 복제하지 않기 위해 원칙만 적는다. 고유 대상명·개별 위치·개수는 쓰지 않는다.
      "밀도 중심": "ex. 중앙과 우측 큰 덩어리", // 시각 밀도가 모이는 곳.
      "여백 방향": "ex. 넓은 순백 여백이 사방으로", // 여백의 양과 방향.
      "겹침": "ex. 최소 — 개체가 서로 닿지 않음", // 개체 간 겹침 정도.
      "균형 유형": "ex. 비대칭 균형, 약한 대각" // 참고 후보: 중앙 / 대칭 / 비대칭 / 삼각 / 대각 / 수평 안정 — 자유 서술.
    },
    "배경·지면": { // '무엇으로 복원할지'까지 정해야 한다. v2 스캐폴드는 캐스트를 빼라고만 해서 쿨그레이 틴트로 절충됐다.
      "관찰 유형": "ex. 회색 (촬영 캐스트)", // [7개 중 1개 선택: 순백 / 오프화이트 / 틴트 / 그라디언트 / 색면 무대막 / 스튜디오 바닥 / 제품컷 백색 — 분석 근거: refer1 색면 무대막, refer3 제품컷 백색·스튜디오 바닥, refer5·6 캐스트 틴트 실측]. 관찰된 그대로 적는다(복원 목표와 분리).
      "복원 목표": "ex. white", // [5개 중 1개 선택: white / offwhite / tint / studio_floor / stage_backdrop — 분석 근거: Codex v2(tint 절충)·v3(white)·refer3(studio_floor)·refer1(stage_backdrop) 실측]. 그래픽 작품은 white가 기본.
      "의도 근거": "ex. 없음 → white", // 오프화이트·틴트를 유지하려면 근거가 필요하다: 피사체 내부 흰 면과 배경의 색차가 캐스트 보정 뒤에도 남거나, 배경이 선/면으로 닫힌 독립 색면이어야 한다.
      "지면": {
        "그림자 받는 면": "ex. 예 (플랫 오프셋 그림자)", // 지면이 그림자를 받는 면으로 존재하는지.
        "패턴 바닥": "ex. 없음", // 체커·기하 패턴 바닥 유무(refer1은 체커·기하 패턴 바닥이 무대 문법).
        "수평선": "ex. 없음" // 수평선·지평선 처리 유무.
      }
    }
