{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules",
    "dev",
    "lab",
    // scripts/ 는 .gitignore 대상('Experimental/debug scripts')이라 다른 체크아웃에는 없다.
    //   이 테스트만 그 폴더를 import 해서, 저자 머신 밖에서는 항상 타입체크·테스트가 깨진다.
    //   제품 코드가 아니므로 검사 대상에서 뺀다 (2026-08-12 오너 지시).
    "tests/seed-test-accounts.test.ts"
  ]
}
