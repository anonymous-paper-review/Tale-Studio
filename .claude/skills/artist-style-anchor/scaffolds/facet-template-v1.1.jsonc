      "물결 부호": "ex. 짧은 곡선 2~3개", // 물결·반사를 나타내는 부호.
      "하이라이트": "ex. 없음" // 액체 표면 하이라이트 유무.
    },
    "발광체": {
      "표현": "ex. [외삽] 플랫 채움", // 램프·창·화면을 플랫 채움으로 그리는지 글로우를 입히는지.
      "글로우": "ex. [외삽] 없음", // 발광체 주변 번짐.
      "라이트 콘": "ex. [외삽] 플랫 웨지", // 발광체가 만드는 빛 원뿔의 표현.
      "색": "ex. [외삽] 옅은 노랑 또는 흰색" // 발광 색.
